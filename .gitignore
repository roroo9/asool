# Secrets
.env
.env.*
!.env.example

# Book files and page images: copyright of the 1956 footnotes is unverified.
# Keep them OUT of the public repo. Images are served only from the deployment.
data/raw/
data/pages/
*.pdf
*.djvu
*.jp2
web/public/pages/

# Cached model outputs that embed page text are fine to commit; page crops are not.
data/intermediate/**/*.png
data/intermediate/**/*.webp

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node
node_modules/
web/.next/
web/out/
.vercel

# OS
.DS_Store
previews/

# Challenge documents (not ours to publish)
docs/challenge/

# Shamela reference text (used only as a review aid; not redistributed)
data/reference/shamela/*.jsonl

# Raw LLM response cache (local; results are saved under data/intermediate)
data/cache/llm/

# King Fahd Complex Hafs data: downloaded by scripts/fetch_references.sh (redistribution terms not stated)
data/reference/quran/kfgqpc/

# HadeethEnc API cache (re-fetchable)
data/reference/hadeethenc/

# Debug overlays contain page images
data/debug/

# التفسير الميسر via QuranEnc: downloaded by scripts/fetch_references.sh
data/reference/quranenc/
