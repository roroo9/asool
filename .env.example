# Copy to .env and fill in. Never commit .env.

# OpenRouter API key (https://openrouter.ai/keys). Used for answers, question classification
# and query embeddings. Without it the app still runs: search falls back to keyword (BM25)
# search, precomputed answers are served, and new questions show the closest passages only.
OPENROUTER_API_KEY=

# Optional. Only needed to re-run the extraction bake-off / gold-set readers (not to run the app).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Access code for the review screens (/review/...). Empty = review screens open (local use only).
REVIEW_TOKEN=

# Browser origins allowed to call the API directly (the web app proxies /api, so this matters
# only for other sites).
CORS_ORIGINS=http://localhost:3000

# Spending guard for OpenRouter (USD).
DAILY_BUDGET_USD=3
OPENROUTER_BUDGET_USD=40
HARD_BUDGET_USD=38
ANSWER_RATE_LIMIT_PER_HOUR=20
