# Copy to .env and fill in. Never commit .env.

# Required. Google AI Studio key: page parsing (VLM), embeddings, answers.
GEMINI_API_KEY=

# Recommended. Anthropic Console key: second VLM for the bake-off and an
# independent gold-set draft (bias control), and answer generation.
ANTHROPIC_API_KEY=

# Optional. Mistral key: Mistral OCR as the independent third gold-set reader.
MISTRAL_API_KEY=

# Optional. Cohere key for multilingual reranking. Empty = reranker skipped.
COHERE_API_KEY=

# Server settings (safe defaults)
CORS_ORIGINS=http://localhost:3000
DAILY_BUDGET_USD=3
ANSWER_RATE_LIMIT_PER_HOUR=20

# Access code for the gold review screen (share only with the reviewer)
REVIEW_TOKEN=
