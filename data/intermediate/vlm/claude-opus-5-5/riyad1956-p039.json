  {
   "order": 1,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "فتغيَّرَ وجهُهُ حتى كانَ كالصِّرْفِ . ثم قال : فمنْ يعدِلُ إذا لم يعدلِ اللهُ ورسولهُ ؟ ثم قال (١) يرحَمُ اللهُ موسٰى قدْ أوذِيَ بأكثرَ منْ هذا فصبَرَ . فقلتُ لاجرَمَ(٢) لا أرفعُ إليه بعدها حديثاً (٣) »",
   "footnote_markers_in_text": [
    "(١)",
    "(٢)",
    "(٣)"
   ],
   "footnote_marker": "",
   "continues_from_prev": true,
   "continues_to_next": false,
   "confidence": 0.85,
   "issues": [
