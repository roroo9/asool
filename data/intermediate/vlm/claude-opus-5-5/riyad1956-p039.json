   ]
  },
  {
   "order": 2,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "متفق عليه . وقوله « كالصِّرْفِ » هو بكسر الصاد المهملة : وهو صِبْغ أحمرُ .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.88,
   "issues": []
  },
  {
   "order": 3,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أنس رضى الله عنه قال : قال رسول الله صلى الله عليه وسلم :",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.92,
   "issues": []
  },
  {
   "order": 4,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« إذا أراد الله بعبدِهِ الخيرَ عجَّلَ له العقُوبةَ فى الدنْيا (٤) ، وإذا أراد اللهُ بعبدِهِ الشرَّ أمسكَ عنه بذَنْبه(٥) حتى يوَافِيَ بِه(٦) يومَ القيامَةِ »",
   "footnote_markers_in_text": [
    "(٤)",
    "(٥)",
    "(٦)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.85,
   "issues": []
  },
  {
   "order": 5,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وقال النبى صلى الله عليه وسلم ،",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.9,
   "issues": []
  },
  {
   "order": 6,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« إنَّ عِظَمِ الجزاء مع عِظَمِ البلاء(٧)، وإنَّ الله تعالى إذا أحبَّ قوماً ابتلاهم ، فمنْ رضِيَ (٨) فلهُ الرضا ومنْ سَخطَ (٩) فلهُ السخط »",
   "footnote_markers_in_text": [
    "(٧)",
    "(٨)",
    "(٩)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.83,
   "issues": []
  },
  {
   "order": 7,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "رواه الترمذى وقال : حديث حسن .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.93,
   "issues": []
  },
  {
   "order": 8,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أنس رضى الله عنه قال : كانَ ابنٌ لأبى طلحةَ رعى الله عنه يشتكى ؛ فخرج أبو طلحة فقبضَ (١٠) الصبيُّ ، فلمَّا رجع أبو طلحة (١١) قال : ما فعلَ ابْنِي ؟ قالتْ أمُّ سليمٍ وهِيَ أمُّ الصبيِّ : هوَ أسكَنُ (١٢) ما كان فقربتْ لهُ العشاء (١٣) فتعشى ثم أصاب منها (١٤) فلمَّا فرغ (١٥) قالتْ : وارُوا الصبيَّ فلمَّا أصبحَ أبو طلحة أتى رسول الله صلى الله عليه وسلم فأخبرهُ (١٦) . فقال أعرستُمُ الليلةَ ؟ قال : نعم . قال : اللهمَّ باركْ لهما ، فولدتْ (١٧) غلاماً فقال لى أبو طلحةَ",
   "footnote_markers_in_text": [
