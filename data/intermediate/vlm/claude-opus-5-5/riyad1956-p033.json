   ]
  },
  {
   "order": 3,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« هٰذه رحمةٌ (٣) جعلها الله تعالى فى قلوب عباده »",
   "footnote_markers_in_text": [
    "(٣)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.85,
   "issues": []
  },
  {
   "order": 4,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وفى رواية :",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.9,
   "issues": []
  },
  {
   "order": 5,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« فى قلوبِ منْ شاءَ منْ عبـاده وإنما يرحمُ اللهُ منْ عبـاده الرحماءَ »",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.85,
   "issues": []
  },
  {
   "order": 6,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "متفق عليه . ومعنى « تَقَعْقَعُ » : تتحركُ وتضطربُ .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.9,
   "issues": []
  },
  {
   "order": 7,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن صهيب رضى الله عنه أنّ رسول الله صلى الله عليه وسلم قال :",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.9,
   "issues": []
  },
  {
   "order": 8,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« كان ملكٌ فيمنْ كانَ قبلكمْ وكانَ له ساحرٌ فلمّـا كبر قال للملكِ : إنى قدْ كبرتُ فابعثْ (٤) إلىّ غلاماً أعلمْهُ السحرَ ؛ فبعثَ إليه غلاماً يعلمُهُ وكان فى طريقه إذا سلكَ راهبٌ (٥) فقعدَ إليه وسمعَ كلامهُ فأعجبهُ وكان إذا أتى الساحر مرَّ بالراهب وقعـد إليه ، فإذا أتى الساحرَ ضربهُ ، فشكا ذلك إلى الراهبِ فقال : إذا خشيتَ الساحرَ . فقلْ : حبسنِى أهلِى (٦) وإذا خشيتَ أهلكَ فقلْ : حبسنِى الساحرُ فبينما هوَ على ذلك إذ أتى على دابةٍ عظيمة (٧) قد حبستِ الناسَ فقال : اليومَ أعلمُ الساحرُ أفضلُ أم الراهبُ أفضل ؟ فأخـذَ حجراً فقال : اللهمّ إنْ كان أمْرُ الراهبِ أحبَّ إليك منْ أمرِ الساحرِ فاقتلْ هذه الدابةَ حتى يمضى الناسُ فرماها فقتلها ومضى الناسُ فأتى الراهبَ فأخبرهُ . فقال له الراهبُ : أىْ بُنَىَّ أنتَ اليومَ أفضـلُ منى قد بلغَ منْ أمركَ ما أرى وإنكَ ستبتلى (٨) فإن ابتليتَ فلاتدلَّ علىَّ : وكان الغلامُ يبرئُ الأكمه (٩) والأبرصَ (١٠) ويداوى الناسَ منْ سائر الأدواء . فسمع جليسٌ للمَلِكِ كان قد عمىَ",
   "footnote_markers_in_text": [
