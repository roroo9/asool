   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 5,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أبى سعيد وأبى هريرة رضى الله عنهما عن النبى صلى الله عليه وسلم قال :",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.93,
   "issues": []
  },
  {
   "order": 6,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« مايصيبُ المسلِمَ من نصبٍ (٢) ولا وصبٍ ولا همٍّ ولا حزنٍ ولا أذًى ولا غمٍّ حتى الشوْكَة يشاكُها إلَّا كَفَّرَ الله بها منْ خَطاياهُ »",
   "footnote_markers_in_text": [
    "(٢)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.85,
   "issues": [
