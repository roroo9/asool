   ]
  },
  {
   "order": 3,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« اللهُمَّ اغفرْ لِقَوْمى فإنهم لايعلَمونَ »",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
