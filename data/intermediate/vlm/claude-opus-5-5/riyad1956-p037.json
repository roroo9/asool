  {
   "order": 2,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أبى عبدالرحمن عبدالله بن مسعود رضى الله عنه قال : كأنِّى أنظرُ إلى رسولِ الله صلى الله عليه وسلم يحكِى نبيًّا من الأنبياء صلواتُ اللهِ وسلامهُ عليهِمْ ضربَهُ قومهُ فأدموْه وهوَ يمسحُ(١) الدَّمَ عن وجْهِهِ وهوَ يقولُ :",
   "footnote_markers_in_text": [
    "(١)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.85,
