   ]
  },
  {
   "order": 7,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "متفق عليه . و « الوصَبُ »: المرضُ .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.9,
   "issues": []
  },
  {
   "order": 8,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن ابن مسعود رضى الله عنه قال : دخلتُ على النبى صلى الله عليه وسلموهو يوعكُ فقلتُ : يارسول الله إنكَ توعَكُ(٣) وعْكاً شديداً قال",
   "footnote_markers_in_text": [
    "(٣)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.88,
