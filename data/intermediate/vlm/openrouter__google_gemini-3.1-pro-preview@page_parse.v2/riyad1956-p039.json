  {
   "order": 2,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "فتغيَّرَ وجهُهُ حتى كان كالصِّرْفِ . ثم قال : فمنْ يعدِلُ إذا لم يعدلِ اللهُ ورسوله ؟\nثم قال (١) يرحمُ الله موسى قدْ أوذِيَ بأكثرَ منْ هذا فصبرَ . فقلتُ لاجَرَمَ (٢)\nلا أرفعُ إليه بعدها حديثاً (٣) » متفق عليه . وقوله « كالصِّرْفِ » هو بكسر\nالصاد المهملة : وهو صِبْغ أحمرُ .",
   "footnote_markers_in_text": [
    "١",
    "٢",
    "٣"
   ],
   "footnote_marker": "",
   "continues_from_prev": true,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 3,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أنس رضى الله عنه قال : قال رسول الله صلى الله عليه وسلم :",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 4,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« إذا أراد الله بعبدِهِ الخيرَ عجَّلَ له العقوبَةَ فى الدنيا (٤) ، وإذا أراد اللهُ بعبدِهِ الشرَّ أمسكَ عنْه بذنْبِهِ (٥) حتى يوَافِىَ بِهِ (٦) يومَ القيامةِ »",
   "footnote_markers_in_text": [
    "٤",
    "٥",
    "٦"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 5,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وقال النبى صلى الله عليه وسلم ،",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 6,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« إنَّ عِظَمَ الجزاءِ مع عِظَمِ البلاءِ (٧) ، وإنَّ الله تعالى إذا أحبَّ قوماً ابتلاهم ، فمنْ رضِىَ (٨) فلهُ الرضا ومنْ سَخِطَ (٩) فلهُ السخط »",
   "footnote_markers_in_text": [
    "٧",
    "٨",
    "٩"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 7,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "رواه الترمذى وقال : حديث حسن .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 8,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أنس رضى الله عنه قال : كانَ ابنٌ لأبى طلحةَ رضى الله عنه\nيشتكى ؛ فخرج أبو طلحة فقبضَ (١٠) الصبىُّ ، فلمَّا رجع أبو طلحة (١١) قال :\nما فعلَ ابْنى ؟ قالت أمُّ سليم وهىَ أمُّ الصبىِّ : هوَ أسكنُ (١٢) ما كان فقربتْ\nلهُ العشاء (١٣) فتعشى ثم أصاب منها (١٤) فلمَّا فرغَ (١٥) قالتْ : وارُوا الصبىَّ\nفلمَّا أصبحَ أبو طلحة أتى رسول الله صلى الله عليه وسلم فأخبرهُ (١٦) . فقال أعرستُمُ\nالليلة ؟ قال : نعم . قال : اللهمَّ بارك لهما ، فولدتْ (١٧) غلاماً فقال لى أبو طلحة",
   "footnote_markers_in_text": [
