   "issues": []
  },
  {
   "order": 4,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« كنتُ أحبها كأشدِّ ما يحبُّ الرجالُ النساءَ فأردتُها على نفسها فامتنعت منى حتى ألمَّت(٤) بها سنة من السنينَ فجاءتنى فأعطيتها عشرينَ ومائةَ دينارٍ على أنْ تخلِّىَ بينى وبينَ نفسها ففعلتْ ، حتى إذا قدرتُ عليها »",
   "footnote_markers_in_text": [
    "(٤)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
