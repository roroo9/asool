  },
  {
   "order": 3,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« هذه رحمةٌ (٣) جعلها الله تعالى فى قلوب عباده »",
   "footnote_markers_in_text": [
    "(٣)"
   ],
   "footnote_marker": "",
