  {
   "order": 2,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "منهمْ علانيتهمْ وبايعهمْ واستغفرَ لهمْ ووكلَ سرائرهمْ (١) إلى الله تعالى حتى جئتُ .\nفلما سلمتُ تبسَّمَ تبسُّمَ المغضبِ (٢) ثم قال :",
   "footnote_markers_in_text": [
    "(١)",
    "(٢)"
