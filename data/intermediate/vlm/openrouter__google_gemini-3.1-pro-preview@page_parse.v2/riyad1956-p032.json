  {
   "order": 2,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "للمؤمن : إنْ أصابتهُ سرَّاءُ (١) شَكَرَ فكانَ خيراً له ، وإنْ أصابتهُ ضرَّاء صبرَ فكانَ خيراً له »",
   "footnote_markers_in_text": [
    "(١)"
   ],
   "footnote_marker": "",
   "continues_from_prev": true,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 3,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "رواه مسلم .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 4,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أنس رضى الله عنه قال : لمَّا ثقلَ النبيُّ صلى الله عليه وسلم جعل يتغشاهُ الكربُ (٢) فقالت فاطمةُ رضى الله عنها . واكربَ أبتاهُ . فقال :",
   "footnote_markers_in_text": [
    "(٢)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 5,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« ليس على أبيكِ كربٌ (٣) بعدَ اليومِ »",
   "footnote_markers_in_text": [
    "(٣)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 6,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "فلمَّا ماتَ قالتْ : يا أبتاهُ أجابَ ربًّا دعاهُ ، يا أبتاهُ جنةُ الفردوسِ مأْوَاهُ (٤) يا أبتاهُ إلى جبريلَ ننعاهُ (٥) . فلمَّا دُفِنَ قالت فاطمة رضى الله عنها : أطابتْ أنفسكمْ أنْ تحثوا على رسولِ الله صلى الله عليه وسلم الترابَ »",
   "footnote_markers_in_text": [
    "(٤)",
    "(٥)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 7,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "رواه البخارى .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 8,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن أبى زيدٍ أسامة بن زيد بن حارثة مولَى (٦) رسول الله صلى الله عليه وسلم وحبِهِ (٧) وابنِ حبهِ رضى الله عنهما قال : : أرسلتْ بنتُ (٨) النبيِّ صلى الله عليه وسلم إنَّ ابنى قد احتضرَ (٩) فاشهدنا (١٠) فأرسلَ يقرئُ السلامَ ويقولُ :",
   "footnote_markers_in_text": [
    "(٦)",
    "(٧)",
    "(٨)",
    "(٩)",
    "(١٠)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 9,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« إنَّ للهِ ما أخذَ وله ما أعطى وكلُّ شىء عندهُ بأَجلٍ (١١) مسمى فلتصبرْ ولتحتسب (١٢)",
   "footnote_markers_in_text": [
    "(١١)",
    "(١٢)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 10,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "فأرسلتْ إليه تقسمُ عليهِ ليأتينها ، فقام ومعه سعدُ بنُ عبادةَ ، ومعاذ بنُ جبلٍ ،",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": true,
   "confidence": 0.95,
   "issues": []
  },
  {
   "order": 11,
   "type": "footnote",
   "author_role": "editor",
   "column": 1,
   "text": "(١) ما يفرحه وما يؤذيه .",
   "footnote_markers_in_text": [],
   "footnote_marker": "(١)",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.95,
