   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 4,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "فقال رجلٌ من بنى سلمةَ : يارسول الله حبسهُ برداهُ والنظرُ فى عطفيهِ (٣) . فقال له معاذُ بنُ جبل رضى الله عنه : بئس ماقلتَ ! والله يارسول الله ما علمنا عليه إلا خيراً ، فسكتَ رسول الله صلى الله عليه وسلم فبينا هو على ذلك رأى رجلاً مبيضاً(٤) يزولُ (٥) به السراب (٦) فقال رسول الله صلى الله عليه وسلم :",
   "footnote_markers_in_text": [
    "(٣)",
    "(٤)",
    "(٥)",
    "(٦)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 5,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "كُنْ أبا خَيْثَمَةَ",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 6,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "فإذا أبو خيثمةَ الانصارى وهو الذى تصدقَ بصاعِ التمرِ حين لمزهُ (٧) المنافقون قال كَعْبٌ : فلما بلغني أنَّ رسول الله صلى الله عليه وسلم قد توجهَ قافلا (٨) منْ تبوكَ حضرنى بَثِّى(٩) فطفقتُ أتذكرُ الكذبَ وأقولُ : بِمَ أخرجُ منْ سخطه(١٠) غدًا وأستعينُ على ذلك بكل ذي رأى منْ أهلى ، فلما قيلَ إنَّ رسول الله صلى الله عليه وسلم قد أظلَّ(١١) قادما راحَ (١٢) عنى الباطلُ حتى عرفتُ أنى لم أنجُ(١٣) منه بشيء أبدا ، فأجمعتُ (١٤) صدقهُ وأصبحَ رسول الله صلى الله عليه وسلم قادما ، وكانَ إذا قدمَ من سفر بدأَ بالمسجدِ فركعَ فيه ركعتين _ (١٥) ثمَّ جلسَ للناس ، فلما فعلَ ذلك جاءهُ المخلفونَ (١٦) يعتذرونَ إليهِ ويحلفونَ لهُ . وكانوا بضعًا وثمانينَ رجلا فقبلَ",
