   "issues": []
  },
  {
   "order": 7,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": ". وفى رواية :",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 8,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "« فنأى بصدرهِ نحوها » .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 1.0,
   "issues": []
  },
  {
   "order": 9,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "وعن عبد الله بن كعب بن مالك وكان قائدَ كعب رضى الله عنه من بنيه حين عمىَ قال : سمعت كعب بن مالك رضى الله عنه يحدث بحديثهِ حين تخلفَ عن رسول الله صلى الله عليه وسلم فى غزوةِ تبوك(٣) . قال كعبٌ :",
   "footnote_markers_in_text": [
    "(٣)"
   ],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
  },
  {
   "order": 10,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "text": "لم أتخلفْ عن رسول الله صلى الله عليه وسلم فى غزوةٍ غزاها قطُّ إلا فى غزوةِ تبوكَ غيرَ أنى قدْ تخلفتُ فى غزوةِ بدر ولم يعاتبْ أحدٌ تخلفَ عنهُ ، إنما خرج رسول الله صلى الله عليه وسلم والمسلمونَ يريدون عيرَ قريشٍ حتى جمع الله تعالى بينهمْ وبينَ عدوِّهمْ على غيرِ(٤) ميعاد .",
   "footnote_markers_in_text": [
    "(٤)"
   ],
