  {
   "order": 3,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "text": "رواه مسلم . « ذروة الجبل » أعلاه وهى « بكسر الذال المعجمة وضمها » والقرقور : بضم القافين نوع من السفن و « الصعيد » هنا : الأرض البارزة و « الأخدود » الشقوق فى الأرض كالنهر الصغير و « أضرم » أوقد « وانكفأت » أى : انقلبت و « تقاعست » : توقفت وجبنت .",
   "footnote_markers_in_text": [],
   "footnote_marker": "",
   "continues_from_prev": false,
   "continues_to_next": false,
   "confidence": 0.99,
   "issues": []
