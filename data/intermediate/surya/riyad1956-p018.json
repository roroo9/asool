   "column": 0,
   "text": "باب التوبة",
   "footnote_marker": "",
   "bbox": [
    911.1999999999999,
    456.62399999999997,
    1219.936,
    544.3199999999999
   ],
   "confidence": 0.9623897190399407
  },
  {
   "order": 3,
   "type": "body",
   "author_role": "unknown",
   "column": 0,
   "text": "قال العلماء : التوبة(١) واجبة(٢) من كل ذنب فإن كانت المعصية بين العبد وبين الله تعالى لا تتعلق بحق آدمي فلها ثلاثة شروط : أحدها أن يقلع(٢) عن المعصية والثاني أن يندم على فعلها ، والثالث أن يعزم أن لا يعود إليها أبداً ، فإن فقد أحد الثلاثة لم تصح توبته وإن كانت المعصية تتعلق بآدمي فشروطها أربعة هذه الثلاثة وأن يبرأ من حق صاحبها(٣) . فإن كانت مالاً أبو نحوه رده إليه ، وإن كان حد قذف ونحوه مكنه منه أو طلب عفوه ، وإن كان غيبة استحله منها . ويجب أن يتوب من جميع الذنوب ، فإن تاب من بعضها صحت توبته عند أهل الحق من ذلك الذنب وبقي عليه الباقي . وقد تظاهرت دلائل الكتاب ، والسنة واجماع الأمة على وجوب التوبة .",
   "footnote_marker": "",
   "bbox": [
    400.928,
    565.4879999999999,
    1730.208,
    1442.4479999999999
   ],
   "confidence": 0.9623897190399407
  },
  {
   "order": 4,
   "type": "body",
   "author_role": "unknown",
   "column": 0,
   "text": "قال الله تعالى : ﴿ وَتُوبُوا إِلَى اللَّهِ جَمِعَا أَيُّهُ الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ ﴾(٤) وقال تعالى ﴿ اَسْتَفْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ ﴾ وقال تعالى ﴿ يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةَ نَصُوحًا ﴾(٥) .",
   "footnote_marker": "",
   "bbox": [
    403.072,
    1451.52,
    1723.776,
    1762.992
   ],
   "confidence": 0.9623897190399407
  },
  {
   "order": 5,
   "type": "body",
   "author_role": "unknown",
   "column": 0,
   "text": "وعن أبي هريرة رضي الله عنه قال : سمعت رسول الله صلى الله عليه وسلم يقول ﴿ وَاللَّهُ إِنِّي لَأُسْتَفْفِرُ اللَّهَ وَأُتَوَبُ إِلَيْهِ ﴾(٦) في اليوم أكثر من سبعين مرة مرة رواه البخاري .",
   "footnote_marker": "",
   "bbox": [
    407.36,
    1787.184,
    1723.776,
    2068.416
   ],
   "confidence": 0.9623897190399407
  },
  {
   "order": 6,
   "type": "body",
   "author_role": "unknown",
   "column": 0,
   "text": "وعن الأغر بن يسار المزني رضي الله عنه قال : قال رسول الله صلى الله عليه وسلم ﴿ يَأْيُّهَا النَّاسُ تُوبُوا إِلَى اللَّهِ وَاسْتَفْفِرُوهُ فَإِنِّي أُتَوَبُ فِي اليَّوْمِ مَاتَةً مَرْقَى رواه مسلم .",
   "footnote_marker": "",
   "bbox": [
