   "column": 0,
   "footnote_marker": "",
   "text": "( بسم الله الرحمن الرحيم )",
   "type_reader_c": "body",
   "type_confirmed": null
  },
  {
   "order": 3,
   "type": "heading",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "باب الإخلاص وإحضار النية فى جميع الأعمال والأقوال والأحوال البارزة والخفية",
   "type_reader_c": "body",
   "type_confirmed": null
  },
  {
   "order": 4,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "قال الله تعالى :",
   "type_reader_c": "footnote",
   "type_confirmed": null
  },
  {
   "order": 5,
   "type": "quran",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "﴿ وَمَا أُمِرُوا إِلاَّ لِيَعْبُدُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ(١) حُنَفَاءَ(٢) وَيُقِيمُوا الصَّلاَةَ ، وَيُؤْتُوا الزَّكَاةَ ، وَذَلِكَ دِينُ الْقَيِّمَةِ ﴾ (٣)",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 6,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "وقال تعالى :",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 7,
   "type": "quran",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "﴿ لَنْ يَنَالَ اللَّهَ لُحُومُهَا وَلاَ دِمَاؤُهَا وَلَكِنْ يَنَالُهُ التَّقْوَى مِنْكُمْ ﴾ (٤)",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 8,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "وقال تعالى :",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 9,
   "type": "quran",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "﴿ قُلْ إِنْ تُخْفُوا مَا فِي صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ اللَّهُ ﴾ .",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 10,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "وعن أمير المؤمنين أبى حفصٍ عمرَ بن الخطاب بن نُفيلِ بن عبدِ العُزَّى بن رِياح بن عبد الله بن قرطِ بن رزاح بن عدىٍّ بن كعبِ بن لؤىٍّ بنَ غالب القرشىِّ العدوىِّ رضى الله عنه قال سمعت رسولالله صلى الله عليه وسلم يقول :",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 11,
   "type": "hadith",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "« إنما الأعمالُ(٥) بالنيَّاتِ ، و إنما لكلِّ امرئٍ ما نوَى : فمَنْ كانت هجرتُه إلى اللهِ ورسولهِ ، فهجرتُه إلى اللهِ ورسولهِ ومَن كانت هجرتُه لدُنيا يصيبُها ، أو امرأةٍ ينكحُها (٦) فهجرتُه إلى ما هاجرَ إليه »",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 12,
   "type": "body",
   "author_role": "matn",
   "column": 0,
   "footnote_marker": "",
   "text": "متفق على صحتهِ . رواه إمامَا المحدِّثين : أبو عبدِ الله محمد بن إسماعيل بن إبراهيم بن المُغيرة بن بَرْدِزْبَهْ الْجُعْفِيّ البخارى ، وأبو الحسيْن مسلم بن الحجاج بن مسلمٍ الْقُشَيْرِى النَّيسابورى رضى الله عنهما فى كتابيهما اللذين هما أصحُّ الكتبِ المصنَّفة .",
   "type_reader_c": null,
   "type_confirmed": null
  },
  {
   "order": 13,
   "type": "footnote",
   "author_role": "editor",
   "column": 0,
   "footnote_marker": "(١)",
   "text": "(١) موحدين",
   "type_reader_c": "footnote",
   "type_confirmed": null
  },
  {
   "order": 14,
   "type": "footnote",
   "author_role": "editor",
   "column": 0,
   "footnote_marker": "(٢)",
   "text": "(٢) مائلين إلى الإسلام",
   "type_reader_c": "footnote",
   "type_confirmed": null
  },
  {
   "order": 15,
   "type": "footnote",
   "author_role": "editor",
   "column": 0,
   "footnote_marker": "(٣)",
   "text": "(٣) الجماعة المستقيمة",
   "type_reader_c": "footnote",
   "type_confirmed": null
  },
  {
   "order": 16,
   "type": "footnote",
   "author_role": "editor",
   "column": 0,
   "footnote_marker": "(٤)",
   "text": "(٤) ما أريد به وجه الله تعالى",
   "type_reader_c": "footnote",
   "type_confirmed": null
  },
  {
   "order": 17,
   "type": "footnote",
   "author_role": "editor",
   "column": 0,
   "footnote_marker": "(٥)",
   "text": "(٥) حركات البدنلا يعتد بها إلا بنية التوجه إلىالله تعالى بقصد ونية",
   "type_reader_c": "footnote",
   "type_confirmed": null
  },
